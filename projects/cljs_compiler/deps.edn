{:paths ["src"]
 :deps {org.clojure/clojurescript {:local/root "/home/jmonetta/my-projects/clojurescript"}}

 ;; This is not needed if you have them globally (recommended)!
 ;; Duplicated it here just because on VSCode it isn't easy to start a repl with
 ;; global aliases the first time
 :aliases
 {:1.13-storm {:classpath-overrides {org.clojure/clojure nil}
               :extra-deps {com.github.flow-storm/clojure {:mvn/version  "1.13.0-alpha4"}
                            com.github.flow-storm/flow-storm-dbg {:mvn/version "4.7.0"}}
               :jvm-opts ["-Dflowstorm.theme=dark"
                          "-Dcljs.storm.instrumentEnable=true"
                          "-Dcljs.storm.instrumentOnlyPrefixes=dev"
                          "-Dcljs.storm.instrumentAutoPrefixes=false"
]}

  :fs-cljs-compiler-plugin {:extra-deps {com.github.flow-storm/flow-storm-cljs-compiler-plugin {:mvn/version "1.0.0-beta5"}}
                            :jvm-opts ["-Dclojure.storm.instrumentOnlyPrefixes.cljsCompilerPlugin=cljs."
                                       "-Dflowstorm.plugins.namespaces.cljsCompilerPlugin=flow-storm.plugins.cljs-compiler.all"]}}}
